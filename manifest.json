{
  "manifest_version": 3,
  "name": "Social Keyboard Navigator",
  "version": "2.0",
  "description": "Navigate Reddit and Bluesky using keyboard shortcuts (J/K for navigation, H to hide)",
  "permissions": [],
  "content_scripts": [
    {
      "matches": [
        "*://old.reddit.com/*",
        "*://*.old.reddit.com/*",
        "*://reddit.com/*",
        "*://*.reddit.com/*",
        "*://bsky.app/*",
        "*://*.bsky.app/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ]
}
